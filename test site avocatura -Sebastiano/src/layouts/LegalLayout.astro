---
import BaseLayout from "./BaseLayout.astro";
import SignatureLine from "../components/SignatureLine.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  updated?: string;
  testNote?: string;
}
const { title, description, path, updated, testNote } = Astro.props;
---

<BaseLayout title={title} description={description} breadcrumbs={[{ name: title, href: path }]}>
  <section class="container page-hero">
    <span class="eyebrow">Informații legale</span>
    <h1>{title}</h1>
    <SignatureLine variant="divider" class="ph-line" />
    {testNote && <p class="test-note">{testNote}</p>}
    {updated && <p class="muted updated">Ultima actualizare: {updated}</p>}
  </section>
  <div class="container legal">
    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  :global(.ph-line) { margin: 2rem 0 1.5rem; }
  .updated { font-size: 0.9375rem; margin-top: 1rem; }
  .legal { padding-bottom: var(--section); }
  .legal :global(h2) { font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.875rem); }
  .legal :global(dl) { display: grid; grid-template-columns: max-content 1fr; gap: 0.75rem 2rem; }
  .legal :global(dt) { color: var(--muted-text); }
  .legal :global(dd) { margin: 0; }
  @media (max-width: 30rem) { .legal :global(dl) { grid-template-columns: 1fr; gap: 0.2rem; } .legal :global(dd) { margin-bottom: 0.75rem; } }
</style>
