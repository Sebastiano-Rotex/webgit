---
import { site, nav, legalNav, phoneHref } from "../config/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-id">
      <p class="footer-name">{site.name}</p>
      <p class="muted">{site.form}<br />Avocat definitiv, {site.bar}</p>
    </div>

    <address class="footer-contact">
      <p>{site.address}</p>
      <p><a href={phoneHref}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p class="muted">{site.hours}</p>
    </address>

    <nav aria-label="Pagini" class="footer-nav">
      <ul>
        {nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Informații legale" class="footer-nav">
      <ul>
        {legalNav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {site.form}. Toate drepturile rezervate.</p>
    {site.testMode && <p>Site de test — toate datele afișate sunt fictive.</p>}
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-top: clamp(3rem, 6vw, 5rem);
    font-size: 0.9688rem;
  }
  .footer-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 64rem) { .footer-grid { grid-template-columns: 1.4fr 1.4fr 1fr 1fr; } }

  .footer-name { font-family: var(--font-display); font-size: 1.5rem; margin-bottom: 0.5rem; }
  address { font-style: normal; }
  address p { margin-bottom: 0.75rem; }
  .footer-contact a, .footer-nav a {
    display: inline-flex; align-items: center; min-height: 44px;
  }
  .footer-nav ul { list-style: none; margin: 0; padding: 0; }
  .footer-nav a { color: var(--ink); text-decoration: none; }
  .footer-nav a:hover { color: var(--accent); text-decoration: underline; }

  .footer-bottom {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem;
    margin-top: 3rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted-text);
    font-size: 0.875rem;
  }
  .footer-bottom p { margin: 0; }
</style>
