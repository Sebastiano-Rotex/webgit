---
interface Props {
  items: { q: string; a: string }[];
  headingLevel?: "h2" | "h3";
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq-item">
        <summary>
          <span class="faq-q">{item.q}</span>
          <span class="faq-icon" aria-hidden="true" />
        </summary>
        <div class="faq-a">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq { border-top: 1px solid var(--line); max-width: 52rem; }
  .faq-item { border-bottom: 1px solid var(--line); }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 44px;
    padding: 1.35rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(1.1875rem, 1.1rem + 0.4vw, 1.375rem);
    line-height: 1.3;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover .faq-q { color: var(--accent); }
  .faq-icon {
    position: relative;
    flex: none;
    width: 1rem; height: 1rem;
  }
  .faq-icon::before, .faq-icon::after {
    content: ""; position: absolute; left: 0; right: 0; top: 50%;
    height: 1.5px; background: var(--accent);
    transition: transform 0.3s var(--ease-out);
  }
  .faq-icon::after { transform: rotate(90deg); }
  details[open] .faq-icon::after { transform: rotate(0deg); }
  .faq-a { padding: 0 2.5rem 1.5rem 0; max-width: var(--measure); }
  .faq-a p { margin: 0; color: var(--ink); }
  @media (prefers-reduced-motion: no-preference) {
    details[open] .faq-a { animation: faq-in 0.35s var(--ease-out); }
  }
  @keyframes faq-in { from { opacity: 0; transform: translateY(-4px); } }
</style>
