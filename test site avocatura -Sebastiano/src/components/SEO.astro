---
import { getImage } from "astro:assets";
import ogDefault from "../assets/test/og-image.jpg";
import { site } from "../config/site";

export interface Crumb { name: string; href: string }

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  image?: ImageMetadata;
  imageAlt?: string;
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: Crumb[];
  publishedTime?: Date;
}

const {
  title,
  description,
  type = "website",
  image = ogDefault,
  imageAlt = "Imagine de prezentare a cabinetului de avocat",
  jsonLd = [],
  breadcrumbs,
  publishedTime,
} = Astro.props;

const base = Astro.site ?? new URL(site.domain);
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/"), base).href;
const fullTitle = Astro.url.pathname === "/" ? `${site.name} — avocat în ${site.city}` : `${title} — ${site.name}`;

const og = await getImage({ src: image, width: 1200, height: 630, format: "jpg", fit: "cover" });
const ogUrl = new URL(og.src, base).href;

const ld = [...jsonLd];
if (breadcrumbs?.length) {
  ld.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [{ name: "Acasă", href: "/" }, ...breadcrumbs].map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.name,
      item: new URL(c.href, base).href,
    })),
  });
}
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{site.testMode && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:locale" content="ro_RO" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

{ld.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
