---
import { site, nav } from "../config/site";
import TestBanner from "./TestBanner.astro";

const path = Astro.url.pathname.replace(/\.html$/, "");
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---

<div class="header-sentinel" aria-hidden="true"></div>
<header class="site-header" data-header transition:animate="none">
  <TestBanner />
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={`${site.name} — pagina principală`}>
      {site.name}
    </a>

    <nav class="nav-desktop" aria-label="Navigare principală">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/contact#formular" class="btn btn--primary btn--sm header-cta">Programează o discuție</a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-open
    >
      <span class="visually-hidden">Deschide meniul</span>
      <span class="burger" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<!-- Sertarul stă în afara header-ului: backdrop-filter ar crea un bloc de conținere pentru position:fixed -->
<div
    id="mobile-menu"
    class="drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Meniu"
    data-menu
    hidden
  >
    <div class="drawer-panel">
      <div class="drawer-top">
        <span class="logo">{site.name}</span>
        <button class="menu-close" type="button" data-menu-close>
          <span class="visually-hidden">Închide meniul</span>
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.5" fill="none"></path>
          </svg>
        </button>
      </div>
      <nav aria-label="Navigare mobilă">
        <ul>
          <li><a href="/" aria-current={path === "/" ? "page" : undefined}>Acasă</a></li>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a href="/contact#formular" class="btn btn--primary">Programează o discuție</a>
      <p class="drawer-meta">{site.phone}<br />{site.hours}</p>
    </div>
  </div>

<style>
  .header-sentinel { position: absolute; top: 0; height: 40px; width: 1px; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .site-header.is-compact { border-bottom-color: var(--line); }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
    transition: height 0.35s var(--ease-out);
  }
  .site-header.is-compact .header-inner { height: 3.75rem; }

  .logo {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    font-weight: 450;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .nav-desktop { display: none; margin-left: auto; }
  .nav-desktop ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .nav-desktop a {
    display: inline-flex; align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9688rem;
    position: relative;
  }
  .nav-desktop a::after {
    content: ""; position: absolute; left: 0.75rem; right: 0.75rem; bottom: 0.6rem;
    height: 1px; background: var(--accent);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }
  .nav-desktop a:hover::after,
  .nav-desktop a[aria-current="page"]::after { transform: scaleX(1); }
  .nav-desktop a[aria-current="page"] { color: var(--accent); }

  .header-cta { display: none; }

  .menu-toggle, .menu-close {
    margin-left: auto;
    width: 48px; height: 48px;
    display: inline-grid; place-items: center;
    background: none; border: 0; color: var(--ink);
    cursor: pointer; border-radius: var(--radius);
  }
  .burger { display: grid; gap: 7px; width: 26px; }
  .burger span { height: 1.5px; background: currentColor; display: block; }
  .burger span:last-child { width: 70%; justify-self: end; }

  @media (min-width: 64rem) {
    .nav-desktop, .header-cta { display: block; }
    .header-cta { display: inline-flex; }
    .menu-toggle { display: none; }
  }

  /* Sertar mobil */
  .drawer {
    position: fixed; inset: 0; z-index: 100;
    background: color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .drawer[hidden] { display: none; }
  .drawer-panel {
    position: absolute; inset: 0 0 0 auto;
    width: min(26rem, 100%);
    background: var(--paper);
    padding: 1rem var(--gutter) 2rem;
    display: flex; flex-direction: column; gap: 2rem;
    overflow-y: auto;
    animation: drawer-in 0.35s var(--ease-out);
  }
  @keyframes drawer-in { from { transform: translateX(16px); opacity: 0; } }
  .drawer-top { display: flex; align-items: center; justify-content: space-between; }
  .drawer nav ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .drawer nav li { border-bottom: 1px solid var(--line); }
  .drawer nav a {
    display: flex; align-items: center; min-height: 56px;
    font-family: var(--font-display); font-size: 1.625rem;
    color: var(--ink); text-decoration: none;
  }
  .drawer nav a[aria-current="page"] { color: var(--accent); }
  .drawer-meta { color: var(--muted-text); font-size: 0.9375rem; margin: 0; }
</style>
