---
import { Picture } from "astro:assets";
import portrait from "../assets/test/portret-avocata.jpg";
import { site } from "../config/site";
import SignatureLine from "./SignatureLine.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-text">
      <span class="eyebrow">Avocat · {site.bar}</span>
      <h1 id="hero-title">
        <span class="hero-prefix">Av.</span>
        {site.name.replace(/^Av\.\s*/, "")}
      </h1>
      <SignatureLine variant="hero" />
      <p class="lead">
        Drept civil, al familiei și al muncii, pentru persoane și firme mici din {site.city}.
      </p>
      <div class="btn-row">
        <a href="/contact#formular" class="btn btn--primary">Programează o discuție</a>
        <a href="/domenii" class="btn">Vezi domeniile</a>
      </div>
    </div>

    <figure class="hero-portrait">
      <div class="frame">
        <Picture
          src={portrait}
          formats={["avif", "webp"]}
          widths={[400, 640, 900, 1200]}
          sizes="(min-width: 64rem) 32rem, (min-width: 48rem) 45vw, 90vw"
          width={1200}
          height={1500}
          alt="Portret al avocatei: o femeie în ținută office, fotografiată în biroul cabinetului, privind spre cameră (imagine de test)."
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </figure>
  </div>
</section>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 6rem) clamp(4rem, 8vw, 7rem); }
  .hero-grid {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
    align-items: center;
  }
  @media (min-width: 48rem) {
    .hero-grid { grid-template-columns: 1.15fr 0.85fr; }
  }

  h1 {
    font-size: clamp(2.75rem, 1.5rem + 5.6vw, 6rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 380;
    margin: 0;
    font-variation-settings: "opsz" 144;
  }
  .hero-prefix {
    display: block;
    font-size: 0.42em;
    letter-spacing: -0.01em;
    color: var(--muted-text);
    margin-bottom: 0.15em;
  }
  .lead { margin-bottom: 2.25rem; }

  .hero-portrait { margin: 0; justify-self: center; width: min(100%, 32rem); }
  .frame {
    position: relative;
    aspect-ratio: 4 / 5;
  }
  .frame::before {
    content: "";
    position: absolute;
    inset: 0;
    transform: translate(clamp(10px, 1.5vw, 18px), clamp(10px, 1.5vw, 18px));
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    pointer-events: none;
  }
  .frame :global(img) {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--line);
  }
</style>
